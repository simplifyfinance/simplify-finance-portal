# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
test-summary.pdf

# Commission and trail reports contain client credit information.
# They are read locally and must never reach the repository.
*.xlsx
*.xls
*.csv
~$*
private/

# scratch used to render and validate emails locally
.tmp-check/
*.eml

# Scratch that the Linux side cannot delete itself
_to_delete/

# Mockups and briefs Claude sends across. Not code, and not the repo's business.
Claude outputs/
